{
  "database": "MONDIAL",
  "constraints": {
    "primary_keys": {
      "city": [
        "name",
        "country",
        "province"
      ],
      "economy": [
        "country"
      ],
      "encompasses": [
        "country",
        "continent"
      ],
      "mountain": [
        "name"
      ],
      "lake": [
        "name"
      ],
      "river": [
        "name"
      ],
      "geo_island": [
        "province",
        "country",
        "island"
      ],
      "geo_lake": [
        "province",
        "country",
        "lake"
      ]
    },
    "foreign_keys": {
      "river": [
        {
          "columns": [
            "river"
          ],
          "referenced_table": "river",
          "referenced_columns": [
            "name"
          ]
        },
        {
          "columns": [
            "lake"
          ],
          "referenced_table": "lake",
          "referenced_columns": [
            "name"
          ]
        }
      ],
      "lake": [
        {
          "columns": [
            "river"
          ],
          "referenced_table": "river",
          "referenced_columns": [
            "name"
          ]
        }
      ],
      "geo_lake": [
        {
          "columns": [
            "lake"
          ],
          "referenced_table": "lake",
          "referenced_columns": [
            "name"
          ]
        }
      ]
    },
    "unique_constraints": {},
    "check_constraints": {
      "encompasses": [
        "(Percentage > 0) AND (Percentage <= 100)"
      ],
      "river": [
        "(River IS NULL AND Lake IS NULL)\n            OR (River IS NULL AND Sea IS NULL)\n            OR (Lake IS NULL AND Sea is NULL)"
      ]
    },
    "indexes": {},
    "inferred_constraints": {}
  }
}