{
  "database": "incoming",
  "tables": {
    "airport": {
      "table": {
        "name": "airport",
        "column_count": 4,
        "summary": "The table represents airports with details such as their identifiers, names, locations, and geographical coordinates.",
        "entity": "Airport",
        "role": "entity_table",
        "aliases": [
          "airports",
          "airport_data"
        ]
      },
      "columns": {
        "iatacode": {
          "name": "iatacode",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Unique identifier for the airport in the form of a three-letter code.",
          "semantic_type": "code",
          "business_concept": "Airport Identifier",
          "aliases": [
            "airport_code",
            "iata_code"
          ]
        },
        "longitude": {
          "name": "longitude",
          "dtype": "decimal",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "Geographical longitude coordinate of the airport.",
          "semantic_type": "quantity",
          "business_concept": "Geographical Coordinates",
          "aliases": [
            "lon",
            "longitude_coord"
          ]
        },
        "elevation": {
          "name": "elevation",
          "dtype": "decimal",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Elevation of the airport above sea level.",
          "semantic_type": "quantity",
          "business_concept": "Physical Attribute",
          "aliases": [
            "elevation_meters",
            "airport_elevation"
          ]
        },
        "gmtoffset": {
          "name": "gmtoffset",
          "dtype": "decimal",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Time zone offset from Coordinated Universal Time (UTC) for the airport.",
          "semantic_type": "quantity",
          "business_concept": "Time Zone",
          "aliases": [
            "timezone_offset",
            "gmt_offset"
          ]
        }
      }
    }
  }
}