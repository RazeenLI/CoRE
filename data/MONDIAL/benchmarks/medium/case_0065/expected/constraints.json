{
  "database": "MONDIAL",
  "constraints": {
    "primary_keys": {
      "city": [
        "name",
        "country",
        "province"
      ],
      "provinceothername": [
        "country",
        "province",
        "othername"
      ],
      "ismember": [
        "country",
        "organization"
      ],
      "mountain": [
        "name"
      ],
      "river": [
        "name"
      ],
      "geo_mountain": [
        "province",
        "country",
        "mountain"
      ],
      "geo_desert": [
        "province",
        "country",
        "desert"
      ],
      "geo_lake": [
        "province",
        "country",
        "lake"
      ]
    },
    "foreign_keys": {
      "river": [
        {
          "columns": [
            "river"
          ],
          "referenced_table": "river",
          "referenced_columns": [
            "name"
          ]
        }
      ],
      "geo_mountain": [
        {
          "columns": [
            "mountain"
          ],
          "referenced_table": "mountain",
          "referenced_columns": [
            "name"
          ]
        }
      ]
    },
    "unique_constraints": {},
    "check_constraints": {
      "river": [
        "(River IS NULL AND Lake IS NULL)\n            OR (River IS NULL AND Sea IS NULL)\n            OR (Lake IS NULL AND Sea is NULL)"
      ]
    },
    "indexes": {},
    "inferred_constraints": {}
  }
}