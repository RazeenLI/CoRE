{
  "database": "MONDIAL",
  "constraints": {
    "primary_keys": {
      "religion": [
        "name",
        "country"
      ],
      "citypops": [
        "country",
        "province",
        "city",
        "year"
      ],
      "encompasses": [
        "country",
        "continent"
      ],
      "organization": [
        "abbreviation"
      ],
      "mountain": [
        "name"
      ],
      "desert": [
        "name"
      ],
      "lake": [
        "name"
      ],
      "riverthrough": [
        "river",
        "lake"
      ],
      "geo_estuary": [
        "province",
        "country",
        "river"
      ],
      "locatedon": [
        "city",
        "province",
        "country",
        "island"
      ],
      "airport": [
        "iatacode"
      ]
    },
    "foreign_keys": {
      "riverthrough": [
        {
          "columns": [
            "lake"
          ],
          "referenced_table": "lake",
          "referenced_columns": [
            "name"
          ]
        }
      ],
      "islandin": [
        {
          "columns": [
            "lake"
          ],
          "referenced_table": "lake",
          "referenced_columns": [
            "name"
          ]
        }
      ]
    },
    "unique_constraints": {
      "organization": [
        [
          "name"
        ]
      ]
    },
    "check_constraints": {
      "encompasses": [
        "(Percentage > 0) AND (Percentage <= 100)"
      ]
    },
    "indexes": {},
    "inferred_constraints": {}
  }
}