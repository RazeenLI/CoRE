{
  "database": "incoming",
  "tables": {
    "catalog_returns": {
      "table": {
        "name": "catalog_returns",
        "column_count": 4,
        "summary": "This table represents catalog returns, capturing details about returned items, including dates, quantities, financials, and related entities such as customers, demographics, and addresses.",
        "entity": "Catalog Return",
        "role": "transaction_table",
        "aliases": [
          "returns_catalog",
          "catalog_returns_data"
        ]
      },
      "columns": {
        "cr_item_sk": {
          "name": "cr_item_sk",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A surrogate key identifying the item that was returned.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Item Identifier",
          "aliases": [
            "item_sk",
            "return_item_sk"
          ]
        },
        "cr_order_number": {
          "name": "cr_order_number",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The order number associated with the return.",
          "semantic_type": "identifier",
          "business_concept": "Order Identifier",
          "aliases": [
            "order_number",
            "order_id"
          ]
        },
        "cr_returning_addr_sk": {
          "name": "cr_returning_addr_sk",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A surrogate key identifying the address associated with the return.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Address Identifier",
          "aliases": [
            "returning_addr_sk",
            "addr_sk"
          ]
        },
        "cr_store_credit": {
          "name": "cr_store_credit",
          "dtype": "decimal",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The store credit provided to the customer as a result of the return.",
          "semantic_type": "money",
          "business_concept": "Store Credit",
          "aliases": [
            "store_credit",
            "credit"
          ]
        }
      }
    }
  }
}