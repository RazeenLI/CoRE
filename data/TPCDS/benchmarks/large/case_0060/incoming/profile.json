          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A surrogate key identifying the item that was returned.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Item Identifier",
          "aliases": [
