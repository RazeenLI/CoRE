{
  "database": "incoming",
  "tables": {
    "takes": {
      "table": {
        "name": "takes",
        "column_count": 6,
        "summary": "Records of students taking specific courses in a given semester and year, including the grade received.",
        "entity": "StudentCourseEnrollment",
        "role": "transaction_table",
        "aliases": [
          "enrollments",
          "takes",
          "course_takes",
          "student_courses"
        ]
      },
      "columns": {
        "id": {
          "name": "id",
          "dtype": "string",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for each enrollment record.",
          "semantic_type": "identifier",
          "business_concept": "Primary Key",
          "aliases": [
            "enrollment_id",
            "record_id",
            "takes_id"
          ]
        },
        "course_id": {
          "name": "course_id",
          "dtype": "string",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier linking to the specific course being taken.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Course Reference",
          "aliases": [
            "course",
            "cid",
            "course_ref"
          ]
        },
        "sec_id": {
          "name": "sec_id",
          "dtype": "string",
          "value_patterns": [
            "boolean_like",
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier for the specific section of the course.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Section Reference",
          "aliases": [
            "section_id",
            "sec",
            "section_ref"
          ]
        },
        "semester": {
          "name": "semester",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "The semester during which the course was taken.",
          "semantic_type": "code",
          "business_concept": "Academic Term",
          "aliases": [
            "term",
            "sem",
            "semester_name"
          ]
        },
        "year": {
          "name": "year",
          "dtype": "decimal",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The calendar year in which the course was taken.",
          "semantic_type": "date",
          "business_concept": "Academic Year",
          "aliases": [
            "year_id",
            "yr",
            "academic_year"
          ]
        },
        "grade": {
          "name": "grade",
          "dtype": "string",
          "value_patterns": [],
          "meaning": "The letter grade assigned to the student for the course.",
          "semantic_type": "code",
          "business_concept": "Academic Performance",
          "aliases": [
            "gpa_grade",
            "mark",
            "score",
            "result"
          ]
        }
      }
    }
  }
}