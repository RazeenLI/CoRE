{
  "database": "incoming",
  "tables": {
    "documents_mailed": {
      "table": {
        "name": "documents_mailed",
        "column_count": 3,
        "summary": "Records tracking the mailing of documents to specific addresses with associated timestamps.",
        "entity": "mailing_record",
        "role": "transaction_table",
        "aliases": [
          "mailed_documents",
          "document_mailings",
          "mail_log"
        ]
      },
      "columns": {
        "document_id": {
          "name": "document_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the document being mailed.",
          "semantic_type": "identifier",
          "business_concept": "document_reference",
          "aliases": [
            "doc_id",
            "document_ref",
            "id"
          ]
        },
        "mailed_to_address_id": {
          "name": "mailed_to_address_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier linking the mailing record to a specific recipient address.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "recipient_address_reference",
          "aliases": [
            "address_id",
            "to_address_id",
            "recipient_id"
          ]
        },
        "mailing_date": {
          "name": "mailing_date",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The timestamp when the document was mailed.",
          "semantic_type": "timestamp",
          "business_concept": "mailing_time",
          "aliases": [
            "sent_date",
            "mail_time",
            "timestamp"
          ]
        }
      }
    }
  }
}