{
  "database": "incoming",
  "tables": {
    "engineer_visits": {
      "table": {
        "name": "engineer_visits",
        "column_count": 8,
        "summary": "Records tracking individual engineer visits to address faults, including associated staff, status, and timestamps.",
        "entity": "Engineer Visit",
        "role": "transaction_table",
        "aliases": [
          "engineer_visits",
          "visit_log",
          "fault_visit_records"
        ]
      },
      "columns": {
        "engineer_visit_id": {
          "name": "engineer_visit_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific engineer visit record.",
          "semantic_type": "identifier",
          "business_concept": "Visit ID",
          "aliases": [
            "visit_id",
            "id",
            "visit_key"
          ]
        },
        "contact_staff_id": {
          "name": "contact_staff_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier of the staff member contacted during the visit.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Contact Staff ID",
          "aliases": [
            "staff_id",
            "contact_id",
            "employee_id"
          ]
        },
        "engineer_id": {
          "name": "engineer_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier of the engineer who performed the visit.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Engineer ID",
          "aliases": [
            "engineer_key",
            "tech_id",
            "worker_id"
          ]
        },
        "fault_log_entry_id": {
          "name": "fault_log_entry_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier of the specific fault log entry associated with this visit.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Fault Entry ID",
          "aliases": [
            "fault_id",
            "log_entry_id",
            "ticket_id"
          ]
        },
        "fault_status": {
          "name": "fault_status",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Current status of the fault associated with the visit.",
          "semantic_type": "status",
          "business_concept": "Fault Status",
          "aliases": [
            "status",
            "fault_state",
            "resolution_status"
          ]
        },
        "visit_start_datetime": {
          "name": "visit_start_datetime",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "Timestamp indicating when the engineer visit began.",
          "semantic_type": "timestamp",
          "business_concept": "Visit Start Time",
          "aliases": [
            "start_time",
            "visit_start",
            "arrival_time"
          ]
        },
        "visit_end_datetime": {
          "name": "visit_end_datetime",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "Timestamp indicating when the engineer visit concluded.",
          "semantic_type": "timestamp",
          "business_concept": "Visit End Time",
          "aliases": [
            "end_time",
            "visit_end",
            "departure_time"
          ]
        },
        "other_visit_details": {
          "name": "other_visit_details",
          "dtype": "string",
          "value_patterns": [],
          "meaning": "Additional textual notes or details regarding the visit.",
          "semantic_type": "description",
          "business_concept": "Visit Notes",
          "aliases": [
            "notes",
            "comments",
            "details",
            "remarks"
          ]
        }
      }
    }
  }
