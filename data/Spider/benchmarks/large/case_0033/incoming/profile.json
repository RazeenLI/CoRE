{
  "database": "incoming",
  "tables": {
    "prescribes": {
      "table": {
        "name": "prescribes",
        "column_count": 6,
        "summary": "Records of medication prescriptions issued by physicians to patients, including dosage and appointment details.",
        "entity": "Prescription",
        "role": "transaction_table",
        "aliases": [
          "prescriptions",
          "rx",
          "medication_orders",
          "drug_prescriptions"
        ]
      },
      "columns": {
        "physician": {
          "name": "physician",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the doctor who issued the prescription.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Physician ID",
          "aliases": [
            "doctor_id",
            "provider_id",
            "prescriber_id",
            "physician_id"
          ]
        },
        "patient": {
          "name": "patient",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the patient receiving the medication.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Patient ID",
          "aliases": [
            "patient_id",
            "member_id",
            "subscriber_id",
            "beneficiary_id"
          ]
        },
        "medication": {
          "name": "medication",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the specific drug prescribed.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Medication ID",
          "aliases": [
            "drug_id",
            "product_id",
            "rx_code",
            "npi_id"
          ]
        },
        "date": {
          "name": "date",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The timestamp when the prescription was written or the appointment occurred.",
          "semantic_type": "timestamp",
          "business_concept": "Prescription Date",
          "aliases": [
            "rx_date",
            "order_date",
            "appointment_date",
            "created_at"
          ]
        },
        "appointment": {
          "name": "appointment",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier linking the prescription to a specific medical appointment visit.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Appointment ID",
          "aliases": [
            "visit_id",
            "encounter_id",
            "claim_id",
            "visit_number"
          ]
        },
        "dose": {
          "name": "dose",
          "dtype": "string",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The quantity or dosage of the medication prescribed per unit.",
          "semantic_type": "quantity",
          "business_concept": "Dosage",
          "aliases": [
            "dosage",
            "amount",
            "quantity_prescribed",
            "strength"
          ]
        }
      }
    }
  }
}