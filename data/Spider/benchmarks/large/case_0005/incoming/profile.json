          "semantic_type": "foreign_key_candidate",
          "business_concept": "Course Reference",
          "aliases": [
            "course_ref",
            "course_code",
            "catalog_id"
          ]
        },
        "section_code": {
          "name": "section_code",
          "dtype": "string",
          "value_patterns": [
            "boolean_like",
            "integer_like",
            "short_code_like"
          ],
