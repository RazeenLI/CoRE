        "role": "relationship_table",
        "aliases": [
          "teaches",
          "instructor_sections",
          "course_offerings",
          "section_enrollments"
        ]
      },
      "columns": {
        "row_id": {
          "name": "row_id",
          "dtype": "string",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific row in the table, likely representing a unique course section instance.",
          "semantic_type": "identifier",
          "business_concept": "Section Instance ID",
          "aliases": [
            "section_id",
            "row_id",
            "unique_id"
          ]
        },
        "course_code": {
          "name": "course_code",
          "dtype": "string",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
