        "entity": "Race",
        "role": "entity_table",
        "aliases": [
          "f1_races",
          "grand_prix",
          "race_events",
          "racing_schedule"
        ]
      },
      "columns": {
        "raceid": {
          "name": "raceid",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific race event.",
          "semantic_type": "identifier",
          "business_concept": "Race ID",
          "aliases": [
            "id",
            "race_id",
            "event_id"
          ]
        },
        "round": {
          "name": "round",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The sequential number of the race within a specific season.",
          "semantic_type": "quantity",
          "business_concept": "Race Round Number",
          "aliases": [
            "round_num",
            "race_number",
            "event_order"
          ]
        },
        "date": {
          "name": "date",
          "dtype": "text",
          "value_patterns": [
            "date_like",
            "short_code_like"
          ],
          "meaning": "The calendar date on which the race was held.",
          "semantic_type": "date",
          "business_concept": "Race Date",
          "aliases": [
