          ],
          "meaning": "The date and time when the rental transaction was initiated.",
          "semantic_type": "timestamp",
          "business_concept": "Rental Start Time",
          "aliases": [
            "rental_date",
            "rental_start",
            "rental_time"
          ]
        },
        "inventory_id": {
          "name": "inventory_id",
          "dtype": "mediumint unsigned",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference to the specific copy of the movie being rented.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Inventory Item ID",
          "aliases": [
