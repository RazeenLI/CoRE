          "name": "rental_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific rental transaction.",
          "semantic_type": "identifier",
          "business_concept": "Primary Key",
          "aliases": [
            "rental_id",
            "id",
            "rental_number"
          ]
        },
        "rental_date": {
          "name": "rental_date",
          "dtype": "datetime",
