{
  "database": "incoming",
  "tables": {
    "circulation_history": {
      "table": {
        "name": "circulation_history",
        "column_count": 4,
        "summary": "Records tracking the circulation instances of specific documents, including draft and copy numbers, associated with specific employees.",
        "entity": "Circulation Record",
        "role": "transaction_table",
        "aliases": [
          "circulation_log",
          "doc_circulation",
          "copy_history"
        ]
      },
      "columns": {
        "version_num": {
          "name": "version_num",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Sequence number indicating which draft version of the document is being circulated.",
          "semantic_type": "code",
          "business_concept": "Draft Version",
          "aliases": [
            "draft_seq",
            "version_num",
            "draft_id"
          ]
        },
        "document_number": {
          "name": "document_number",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the document being circulated.",
          "semantic_type": "identifier",
          "business_concept": "Document ID",
          "aliases": [
            "doc_id",
            "document_number",
            "ref_id"
          ]
        },
        "user_id": {
          "name": "user_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier of the employee involved in the circulation process (e.g., creator, approver, or recipient).",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Employee ID",
          "aliases": [
            "emp_id",
            "user_id",
            "staff_id"
          ]
        },
        "copy_seq": {
          "name": "copy_seq",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Sequence number indicating which copy of the document is being circulated.",
          "semantic_type": "code",
          "business_concept": "Copy Sequence",
          "aliases": [
            "copy_seq",
            "copy_id",
            "instance_num"
          ]
        }
      }
    }
  }
}