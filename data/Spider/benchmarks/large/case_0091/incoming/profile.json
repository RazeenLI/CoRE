{
  "database": "incoming",
  "tables": {
    "section": {
      "table": {
        "name": "section",
        "column_count": 6,
        "summary": "Stores detailed information about specific course sections, including the course identifier, section number, academic term, location, and time slot.",
        "entity": "Course Section",
        "role": "entity_table",
        "aliases": [
          "sections",
          "class_sections",
          "course_offerings",
          "sec"
        ]
      },
      "columns": {
        "cid": {
          "name": "cid",
          "dtype": "string",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the course being offered in this section.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Course Identifier",
          "aliases": [
            "course",
            "cid",
            "crs_id"
          ]
        },
        "section_id": {
          "name": "section_id",
          "dtype": "string",
          "value_patterns": [
            "boolean_like",
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the specific section of the course within a given term.",
          "semantic_type": "identifier",
          "business_concept": "Section Number",
          "aliases": [
            "section_id",
            "sec",
            "section_num"
          ]
        },
        "sem": {
          "name": "sem",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "The academic semester during which the course section is offered.",
          "semantic_type": "category",
          "business_concept": "Academic Semester",
          "aliases": [
            "term",
            "sem",
            "semester_name"
          ]
        },
        "cal_year": {
          "name": "cal_year",
          "dtype": "decimal",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The calendar year in which the course section is offered.",
          "semantic_type": "date",
          "business_concept": "Academic Year",
          "aliases": [
            "year",
            "cal_year",
            "offering_year"
          ]
        },
        "location_room": {
          "name": "location_room",
          "dtype": "string",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The specific room number within the building where the course section is held.",
          "semantic_type": "code",
          "business_concept": "Room Number",
          "aliases": [
            "room",
            "room_num",
            "location_room"
          ]
        },
        "time_slot": {
          "name": "time_slot",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "A code representing the specific time slot or meeting pattern for the course section.",
          "semantic_type": "code",
          "business_concept": "Time Slot Identifier",
          "aliases": [
            "time_slot",
            "ts_id",
            "meeting_time"
          ]
        }
      }
    }
  }
}