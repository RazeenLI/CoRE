{
  "database": "incoming",
  "tables": {
    "enrollments": {
      "table": {
        "name": "enrollments",
        "column_count": 4,
        "summary": "Historical enrollment statistics aggregated by campus and academic year.",
        "entity": "Campus Enrollment Record",
        "role": "lookup_table",
        "aliases": [
          "enrollment_stats",
          "campus_enrollments",
          "ay_enrollment"
        ]
      },
      "columns": {
        "campus": {
          "name": "campus",
          "dtype": "integer",
          "value_patterns": [
            "boolean_like",
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A unique identifier representing a specific campus location.",
          "semantic_type": "code",
          "business_concept": "Campus ID",
          "aliases": [
            "campus_id",
            "campus_code",
            "location_id"
          ]
        },
        "year": {
          "name": "year",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The academic year for which the enrollment data is recorded.",
          "semantic_type": "date",
          "business_concept": "Academic Year",
          "aliases": [
            "ay",
            "academic_year",
            "school_year"
          ]
        },
        "totalenrollment_ay": {
          "name": "totalenrollment_ay",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The total count of students enrolled during the specified academic year.",
          "semantic_type": "quantity",
          "business_concept": "Total Enrollment Count",
          "aliases": [
            "total_students",
            "headcount",
            "enrollment_count"
          ]
        },
        "fte_ay": {
          "name": "fte_ay",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The total Full-Time Equivalent student count during the specified academic year.",
          "semantic_type": "quantity",
          "business_concept": "Full-Time Equivalent Enrollment",
          "aliases": [
            "fte",
            "full_time_equivalents",
            "weighted_enrollment"
          ]
        }
      }
    }
  }
}