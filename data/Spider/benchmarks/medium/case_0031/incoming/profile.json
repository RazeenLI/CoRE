          "semantic_type": "description",
          "business_concept": "Product Description",
          "aliases": [
            "desc",
            "details",
            "summary"
          ]
        },
        "buy_price": {
          "name": "buy_price",
          "dtype": "string",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The typical cost to purchase the product, stored as a string.",
          "semantic_type": "money",
          "business_concept": "Buying Price",
          "aliases": [
            "buy_price",
            "cost",
            "purchase_price",
            "wholesale_price"
          ]
        },
        "sell_price": {
          "name": "sell_price",
          "dtype": "string",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The typical price at which the product is sold, stored as a string.",
