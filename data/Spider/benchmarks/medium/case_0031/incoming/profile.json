            "short_code_like"
          ],
          "meaning": "Unique identifier for each product record.",
          "semantic_type": "identifier",
          "business_concept": "Product ID",
          "aliases": [
            "id",
            "pid",
            "sku"
          ]
        },
        "name": {
          "name": "name",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "The human-readable name of the product.",
          "semantic_type": "unknown",
          "business_concept": "Product Name",
          "aliases": [
            "name",
            "title",
            "item_name"
          ]
        },
        "color_id": {
          "name": "color_id",
          "dtype": "string",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A code representing the color of the product, stored as a string.",
          "semantic_type": "code",
          "business_concept": "Color Code",
          "aliases": [
            "color",
            "clr",
            "color_id"
          ]
        },
        "extra_info": {
          "name": "extra_info",
          "dtype": "string",
          "value_patterns": [],
          "meaning": "Additional details about the product, currently empty in samples.",
          "semantic_type": "description",
          "business_concept": "Additional Details",
          "aliases": [
            "extra_info",
            "notes",
            "metadata"
          ]
        },
        "category": {
          "name": "category",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "A code or label indicating the category of the product.",
          "semantic_type": "category",
