        "role": "transaction_table",
        "aliases": [
          "occupancy_log",
          "tenancy_records",
          "resident_moves",
          "property_residents"
        ]
      },
      "columns": {
        "resident_id": {
          "name": "resident_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A unique identifier for a resident or tenant.",
          "semantic_type": "identifier",
          "business_concept": "Resident ID",
          "aliases": [
            "resident_key",
            "tenant_id",
            "person_id"
          ]
        },
        "property_id": {
          "name": "property_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A unique identifier for the property where the resident lived.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Property ID",
          "aliases": [
            "property_key",
            "building_id",
            "unit_id"
          ]
        },
        "date_moved_in": {
          "name": "date_moved_in",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The timestamp when the resident started living at the property.",
