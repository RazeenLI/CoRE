        "entity": "Qualifying Session",
        "role": "transaction_table",
        "aliases": [
          "qualifying_results",
          "quali",
          "qualifying_times"
        ]
      },
      "columns": {
        "qualifyid": {
          "name": "qualifyid",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific qualifying session record.",
          "semantic_type": "identifier",
          "business_concept": "Qualifying Session ID",
          "aliases": [
            "quali_id",
            "id"
          ]
        },
        "driverid": {
          "name": "driverid",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier for the driver participating in the qualifying session.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Driver ID",
          "aliases": [
            "driver_id",
            "d_id"
          ]
        },
        "position": {
          "name": "position",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The final grid position achieved by the driver in the qualifying session.",
          "semantic_type": "category",
          "business_concept": "Qualifying Position",
          "aliases": [
            "pos",
            "grid_position",
            "q_position"
          ]
        },
        "q1": {
          "name": "q1",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "Fastest lap time recorded during the first qualifying segment.",
          "semantic_type": "timestamp",
          "business_concept": "Q1 Time",
          "aliases": [
            "q1_time",
            "quali_1_time",
            "segment_1_time"
          ]
        }
      }
    }
  }
}