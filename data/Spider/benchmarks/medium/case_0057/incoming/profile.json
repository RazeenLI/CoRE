{
  "database": "incoming",
  "tables": {
    "course": {
      "table": {
        "name": "course",
        "column_count": 7,
        "summary": "A catalog of academic courses including their titles, credit hours, instructors, and scheduling details.",
        "entity": "Course",
        "role": "lookup_table",
        "aliases": [
          "courses",
          "class_schedule",
          "class_list",
          "curriculum"
        ]
      },
      "columns": {
        "instructor": {
          "name": "instructor",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference ID linking to the faculty member teaching the course.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Instructor ID",
          "aliases": [
            "instructor_id",
            "professor_id",
            "teacher_id",
            "faculty_id"
          ]
        },
        "cid": {
          "name": "cid",
          "dtype": "string",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "Unique identifier for a specific course offering.",
          "semantic_type": "identifier",
          "business_concept": "Course ID",
          "aliases": [
            "course_id",
            "course_code",
            "course_number"
          ]
        },
        "days": {
          "name": "days",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Days of the week the course is held.",
          "semantic_type": "code",
          "business_concept": "Schedule Days",
          "aliases": [
            "day_of_week",
            "schedule_days",
            "meeting_days"
          ]
        },
        "hours": {
          "name": "hours",
          "dtype": "string",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Number of contact hours per week for the course.",
          "semantic_type": "quantity",
          "business_concept": "Weekly Hours",
          "aliases": [
            "contact_hours",
            "weekly_hours",
            "hour_per_week"
          ]
        },
        "cname": {
          "name": "cname",
          "dtype": "string",
          "value_patterns": [],
          "meaning": "Full descriptive title of the course.",
          "semantic_type": "description",
          "business_concept": "Course Name",
          "aliases": [
            "course_title",
            "course_name",
            "class_name"
          ]
        },
        "credits": {
          "name": "credits",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Number of academic credits awarded for completing the course.",
          "semantic_type": "quantity",
          "business_concept": "Credit Hours",
          "aliases": [
            "credit_hours",
            "credits",
            "credit_value"
          ]
        },
        "dno": {
          "name": "dno",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Department number or code associated with the course.",
          "semantic_type": "code",
          "business_concept": "Department Number",
          "aliases": [
            "dept_no",
            "department_code",
            "dept_id"
          ]
        }
      }
    }
  }
}