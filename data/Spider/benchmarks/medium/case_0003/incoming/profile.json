{
  "database": "incoming",
  "tables": {
    "file_location_history": {
      "table": {
        "name": "file_location_history",
        "column_count": 3,
        "summary": "Records the specific time periods during which a document was stored at various physical locations.",
        "entity": "document_location_assignment",
        "role": "transaction_table",
        "aliases": [
          "doc_locations",
          "document_storage_log",
          "file_location_history",
          "document_checkouts"
        ]
      },
      "columns": {
        "document_id": {
          "name": "document_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the document being tracked.",
          "semantic_type": "identifier",
          "business_concept": "Document ID",
          "aliases": [
            "doc_id",
            "document_number",
            "file_id",
            "record_id"
          ]
        },
        "location_code": {
          "name": "location_code",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Short alphanumeric code representing the specific physical or logical storage location.",
          "semantic_type": "code",
          "business_concept": "Storage Location Code",
          "aliases": [
            "loc_code",
            "site_code",
            "warehouse_code",
            "shelf_code"
          ]
        },
        "date_in_location_from": {
          "name": "date_in_location_from",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The timestamp when the document was placed into or checked into the specified location.",
          "semantic_type": "timestamp",
          "business_concept": "Check-in Date",
          "aliases": [
            "start_date",
            "checkout_date",
            "placed_on",
            "from_date"
          ]
        }
      }
    }
  }
}