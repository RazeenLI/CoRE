{
  "database": "incoming",
  "tables": {
    "claims_documents": {
      "table": {
        "name": "claims_documents",
        "column_count": 4,
        "summary": "Stores metadata and creation details for various documents associated with insurance claims.",
        "entity": "claim_document",
        "role": "entity_table",
        "aliases": [
          "claims_docs",
          "claim_documents",
          "doc_metadata"
        ]
      },
      "columns": {
        "claim_id": {
          "name": "claim_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier linking the document to a specific insurance claim.",
          "semantic_type": "identifier",
          "business_concept": "claim_reference",
          "aliases": [
            "claim_ref",
            "claim_no",
            "claim_number"
          ]
        },
        "document_type_code": {
          "name": "document_type_code",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Categorical code indicating the type of document (e.g., Medical, Document).",
          "semantic_type": "code",
          "business_concept": "document_category",
          "aliases": [
            "doc_type",
            "document_category",
            "type_code"
          ]
        },
        "created_by_staff_id": {
          "name": "created_by_staff_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier of the staff member who created or uploaded the document.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "staff_identifier",
          "aliases": [
            "creator_id",
            "staff_id",
            "uploader_id"
          ]
        },
        "created_date": {
          "name": "created_date",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Timestamp representing when the document was created or uploaded, stored as an integer (likely Unix epoch or similar).",
          "semantic_type": "timestamp",
          "business_concept": "creation_time",
          "aliases": [
            "create_time",
            "upload_date",
            "recorded_at"
          ]
        }
      }
    }
  }
}