            "full_settlement"
          ]
        },
        "amount_due": {
          "name": "amount_due",
          "dtype": "decimal",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The total monetary amount remaining to be paid for the associated booking.",
          "semantic_type": "money",
          "business_concept": "Outstanding Balance",
          "aliases": [
            "balance_due",
            "remaining_amount",
            "total_due"
          ]
        },
        "payment_date": {
          "name": "payment_date",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "Timestamp recording when the payment transaction occurred.",
          "semantic_type": "timestamp",
          "business_concept": "Payment Date",
          "aliases": [
