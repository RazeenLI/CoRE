{
  "database": "incoming",
  "tables": {
    "bookings": {
      "table": {
        "name": "bookings",
        "column_count": 5,
        "summary": "A transactional table recording customer bookings, including status, dates, financial details (payable, discounts, refunds), and item counts.",
        "entity": "Booking",
        "role": "transaction_table",
        "aliases": [
          "bookings",
          "booking_records",
          "rental_bookings"
        ]
      },
      "columns": {
        "booking_start_date": {
          "name": "booking_start_date",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The timestamp when the booking period begins.",
          "semantic_type": "timestamp",
          "business_concept": "Start Date",
          "aliases": [
            "start_time",
            "pickup_date",
            "from_date"
          ]
        },
        "booking_end_date": {
          "name": "booking_end_date",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The timestamp when the booking period ends.",
          "semantic_type": "timestamp",
          "business_concept": "End Date",
          "aliases": [
            "end_time",
            "dropoff_date",
            "to_date"
          ]
        },
        "booking_id": {
          "name": "booking_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific booking record.",
          "semantic_type": "identifier",
          "business_concept": "Booking ID",
          "aliases": [
            "id",
            "booking_number",
            "ref_id"
          ]
        },
        "amount_of_discount": {
          "name": "amount_of_discount",
          "dtype": "decimal",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The monetary value of any discount applied to the booking.",
          "semantic_type": "money",
          "business_concept": "Discount Amount",
          "aliases": [
            "discount",
            "deduction",
            "rebate"
          ]
        },
        "count_hired": {
          "name": "count_hired",
          "dtype": "string",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The quantity of items or units hired under this booking.",
          "semantic_type": "quantity",
          "business_concept": "Item Count",
          "aliases": [
