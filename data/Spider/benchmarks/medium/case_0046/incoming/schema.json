{
  "database": "incoming",
  "tables": {
    "film": {
      "columns": {
        "film_code": {
          "type_raw": "SMALLINT UNSIGNED",
          "type": "smallint unsigned",
          "nullable": false
        },
        "movie_title": {
          "type_raw": "VARCHAR(255)",
          "type": "string",
          "max_length": 255,
          "nullable": false
        },
        "plot": {
          "type_raw": "TEXT",
          "type": "text",
          "nullable": true,
          "default": "NULL"
        },
        "release_date": {
          "type_raw": "YEAR",
          "type": "year",
          "nullable": true,
          "default": "NULL"
        },
        "lang_id": {
          "type_raw": "TINYINT UNSIGNED",
          "type": "tinyint unsigned",
          "nullable": false
        },
        "source_language_id": {
          "type_raw": "TINYINT UNSIGNED",
          "type": "tinyint unsigned",
          "nullable": true,
          "default": "NULL"
        },
        "rental_period": {
          "type_raw": "TINYINT UNSIGNED",
          "type": "tinyint unsigned",
          "nullable": false,
          "default": "3"
        },
        "price": {
          "type_raw": "DECIMAL(4,2)",
          "type": "decimal",
          "precision": 4,
          "scale": 2,
          "nullable": false,
          "default": "4.99"
        },
        "duration": {
          "type_raw": "SMALLINT UNSIGNED",
          "type": "smallint unsigned",
          "nullable": true,
          "default": "NULL"
        },
        "cost": {
          "type_raw": "DECIMAL(5,2)",
          "type": "decimal",
          "precision": 5,
          "scale": 2,
          "nullable": false,
          "default": "19.99"
        },
        "classification": {
          "type_raw": "",
          "type": "unknown",
          "nullable": true,
          "default": "'G'"
        },
        "bonus_content": {
          "type_raw": "",
          "type": "unknown",
          "nullable": true,
          "default": "NULL"
        },
        "modification_date": {
          "type_raw": "TIMESTAMP",
          "type": "timestamp",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP"
        }
      },
      "column_order": [
        "film_code",
        "movie_title",
        "plot",
        "release_date",
        "lang_id",
        "source_language_id",
        "rental_period",
        "price",
        "duration",
        "cost",
        "classification",
        "bonus_content",
        "modification_date"
      ]
    }
  }
}