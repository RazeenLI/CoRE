{
  "database": "incoming",
  "tables": {
    "job_history": {
      "table": {
        "name": "job_history",
        "column_count": 3,
        "summary": "Records the employment history of employees, tracking their job titles and departments over time.",
        "entity": "Employee Job History",
        "role": "transaction_table",
        "aliases": [
          "emp_history",
          "job_records",
          "employment_log"
        ]
      },
      "columns": {
        "start_date": {
          "name": "start_date",
          "dtype": "date",
          "value_patterns": [
            "date_like",
            "short_code_like"
          ],
          "meaning": "The date on which the employee began working in the specified job.",
          "semantic_type": "date",
          "business_concept": "Hire Date / Start Date",
          "aliases": [
            "hire_date",
            "begin_date",
            "start"
          ]
        },
        "department_id": {
          "name": "department_id",
          "dtype": "decimal",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier for the department where the employee was assigned during this job tenure.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Department ID",
          "aliases": [
            "dept_id",
            "department",
            "org_unit"
          ]
        },
        "employee_id": {
          "name": "employee_id",
          "dtype": "decimal",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the employee associated with this job record.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Employee ID",
          "aliases": [
            "emp_id",
            "id",
            "employee_number"
          ]
        }
      }
    }
  }
}