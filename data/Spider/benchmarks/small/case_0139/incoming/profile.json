          "order_details",
          "order_line_items",
          "oi"
        ]
      },
      "columns": {
        "order_item_id": {
          "name": "order_item_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific line item within an order.",
          "semantic_type": "identifier",
          "business_concept": "Order Item ID",
          "aliases": [
            "item_id",
            "line_id",
            "order_line_id"
          ]
        },
        "order_id": {
          "name": "order_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference to the parent order containing this item.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Order ID",
          "aliases": [
            "parent_order_id",
            "order_ref"
          ]
        },
        "product_id": {
          "name": "product_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference to the specific product included in this order line.",
