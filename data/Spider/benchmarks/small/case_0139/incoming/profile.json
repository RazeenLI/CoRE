          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The number of units of the product ordered in this line item.",
          "semantic_type": "quantity",
          "business_concept": "Quantity Ordered",
          "aliases": [
            "qty",
            "amount",
            "count",
            "units"
          ]
        },
        "other_order_item_details": {
          "name": "other_order_item_details",
          "dtype": "string",
          "value_patterns": [],
          "meaning": "Optional additional information or notes regarding the specific order item.",
          "semantic_type": "description",
          "business_concept": "Item Notes",
          "aliases": [
            "notes",
            "remarks",
            "extra_info",
            "metadata"
          ]
        }
      }
    }
  }
