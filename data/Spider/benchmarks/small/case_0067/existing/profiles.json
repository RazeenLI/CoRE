{
  "database": "theme_gallery",
  "tables": {
    "exhibition": {
      "table": {
        "name": "exhibition",
        "column_count": 5,
        "summary": "A catalog of art exhibitions including their themes, associated artists, years, and ticket pricing.",
        "entity": "Exhibition",
        "role": "entity_table",
        "aliases": [
          "exhibitions",
          "show_list",
          "art_shows"
        ]
      },
      "columns": {
        "exhibition_id": {
          "name": "exhibition_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific exhibition record.",
          "semantic_type": "identifier",
          "business_concept": "Exhibition ID",
          "aliases": [
            "id",
            "exh_id",
            "show_id"
          ]
        },
        "year": {
          "name": "year",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The calendar year in which the exhibition took place.",
          "semantic_type": "date",
          "business_concept": "Exhibition Year",
          "aliases": [
            "event_year",
            "date",
            "year_held"
          ]
        },
        "theme": {
          "name": "theme",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The subject matter or conceptual focus of the exhibition.",
          "semantic_type": "category",
          "business_concept": "Exhibition Theme",
          "aliases": [
            "topic",
            "subject",
            "title",
            "concept"
          ]
        },
        "artist_id": {
          "name": "artist_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference identifier linking the exhibition to a specific artist.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Artist Reference",
          "aliases": [
            "artist_ref",
            "creator_id",
            "exhibitor_id"
          ]
        },
        "ticket_price": {
          "name": "ticket_price",
          "dtype": "float",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The monetary cost for admission to the exhibition.",
          "semantic_type": "money",
          "business_concept": "Ticket Price",
          "aliases": [
            "price",
            "cost",
            "admission_fee",
            "fare"
          ]
        }
      }
    },
    "exhibition_record": {
      "table": {
        "name": "exhibition_record",
        "column_count": 3,
        "summary": "Records tracking the attendance numbers for specific exhibitions on particular dates.",
        "entity": "exhibition",
        "role": "transaction_table",
        "aliases": [
          "exhibition_attendance",
          "event_record",
          "show_log"
        ]
      },
      "columns": {
        "exhibition_id": {
          "name": "exhibition_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A unique identifier for a specific exhibition event.",
          "semantic_type": "identifier",
          "business_concept": "Exhibition ID",
          "aliases": [
            "exhibition_uuid",
            "event_id",
            "show_id"
          ]
        },
        "date": {
          "name": "date",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The calendar date on which the exhibition took place.",
          "semantic_type": "date",
          "business_concept": "Event Date",
          "aliases": [
            "event_date",
            "show_date",
            "exhibition_date"
          ]
        },
        "attendance": {
          "name": "attendance",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The total count of people who attended the exhibition on the recorded date.",
          "semantic_type": "quantity",
          "business_concept": "Visitor Count",
          "aliases": [
            "attendees",
            "visitor_count",
            "crowd_size"
          ]
        }
      }
    }
  }
}