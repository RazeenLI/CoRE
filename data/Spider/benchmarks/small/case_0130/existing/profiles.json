          "semantic_type": "code",
          "business_concept": "Application Version",
          "aliases": [
            "app_version",
            "application_version",
            "software_version"
          ]
        },
        "software_platform": {
          "name": "software_platform",
          "dtype": "text",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "The operating system platform running on the device.",
          "semantic_type": "category",
          "business_concept": "Operating System",
          "aliases": [
            "os",
            "platform",
            "os_type",
            "system"
          ]
        }
