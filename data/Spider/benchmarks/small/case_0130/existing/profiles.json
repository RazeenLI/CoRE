        "entity": "device",
        "role": "entity_table",
        "aliases": [
          "devices",
          "mobile_devices",
          "device_metadata",
          "device_info"
        ]
      },
      "columns": {
        "device_id": {
          "name": "device_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A unique identifier for each device record in the table.",
          "semantic_type": "identifier",
          "business_concept": "Device ID",
          "aliases": [
            "id",
            "device_uid",
            "device_key"
          ]
        },
        "device": {
          "name": "device",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The name or brand of the mobile device.",
          "semantic_type": "organization_name",
          "business_concept": "Device Model/Brand",
          "aliases": [
            "device_name",
            "device_model",
            "brand",
            "device_type"
          ]
        },
        "carrier": {
          "name": "carrier",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The telecommunications service provider associated with the device.",
          "semantic_type": "organization_name",
          "business_concept": "Mobile Carrier",
          "aliases": [
            "carrier_name",
            "network_provider",
            "isp",
            "service_provider"
          ]
        },
        "package_version": {
          "name": "package_version",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The specific version number of the software package installed on the device.",
          "semantic_type": "code",
          "business_concept": "Software Version",
          "aliases": [
            "version",
            "pkg_version",
            "app_version",
            "release_version"
          ]
        },
        "applications": {
          "name": "applications",
          "dtype": "text",
          "value_patterns": [],
