{
  "database": "device",
  "tables": {
    "stock": {
      "table": {
        "name": "stock",
        "column_count": 3,
        "summary": "Records of stock quantities associated with specific shops and devices.",
        "entity": "stock",
        "role": "transaction_table",
        "aliases": [
          "inventory",
          "stock_levels",
          "warehouse_stock"
        ]
      },
      "columns": {
        "shop_id": {
          "name": "shop_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the shop or store location where the stock is held.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "shop",
          "aliases": [
            "shop_code",
            "store_id",
            "location_id"
          ]
        },
        "device_id": {
          "name": "device_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the specific device or terminal associated with the stock record.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "device",
          "aliases": [
            "device_code",
            "terminal_id",
            "scanner_id"
          ]
        },
        "quantity": {
          "name": "quantity",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The number of items currently in stock.",
          "semantic_type": "quantity",
          "business_concept": "stock_quantity",
          "aliases": [
            "qty",
            "count",
            "amount",
            "units"
          ]
        }
      }
    },
    "device": {
      "table": {
        "name": "device",
        "column_count": 6,
