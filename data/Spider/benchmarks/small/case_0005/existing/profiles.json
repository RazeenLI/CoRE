{
  "database": "soccer_2",
  "tables": {
    "tryout": {
      "table": {
        "name": "tryout",
        "column_count": 4,
        "summary": "Records the results of player tryouts, including the player's unique ID, the organization they tried out for, their position, and the hiring decision.",
        "entity": "Tryout Record",
        "role": "transaction_table",
        "aliases": [
          "tryout_results",
          "player_tryouts",
          "recruitment_log"
        ]
      },
      "columns": {
        "pid": {
          "name": "pid",
          "dtype": "decimal",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the player participating in the tryout.",
          "semantic_type": "identifier",
          "business_concept": "Player ID",
          "aliases": [
            "player_id",
            "p_id",
            "athlete_id"
          ]
        },
        "cname": {
          "name": "cname",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Name or abbreviation of the organization (e.g., university, club) conducting the tryout.",
          "semantic_type": "organization_name",
          "business_concept": "Organization Name",
          "aliases": [
            "org_name",
            "school",
            "team",
            "club_name"
          ]
        },
        "ppos": {
          "name": "ppos",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "The specific playing position the player is being evaluated for.",
          "semantic_type": "category",
          "business_concept": "Player Position",
          "aliases": [
            "position",
            "pos",
            "role",
            "pp"
          ]
        },
        "decision": {
          "name": "decision",
          "dtype": "string",
          "value_patterns": [
            "boolean_like",
            "short_code_like"
          ],
          "meaning": "The outcome of the tryout, indicating whether the player was selected or rejected.",
          "semantic_type": "boolean",
          "business_concept": "Hiring Decision",
          "aliases": [
            "status",
            "result",
            "selected",
            "outcome"
          ]
        }
      }
    },
    "college": {
      "table": {
        "name": "college",
        "column_count": 3,
        "summary": "A dataset containing information about various colleges, including their identifiers, locations, and enrollment figures.",
        "entity": "College",
        "role": "entity_table",
        "aliases": [
          "colleges",
          "universities",
          "institutions",
          "higher_education"
        ]
      },
      "columns": {
        "cname": {
          "name": "cname",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Unique short identifier or code for the college.",
          "semantic_type": "code",
          "business_concept": "College Identifier",
          "aliases": [
            "college_code",
            "school_code",
            "institution_code",
            "abbr"
          ]
        },
        "state": {
          "name": "state",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Two-letter postal code representing the state where the college is located.",
          "semantic_type": "code",
          "business_concept": "State Location",
          "aliases": [
            "state_code",
            "location_state",
            "postal_state"
          ]
        },
        "enr": {
          "name": "enr",
          "dtype": "decimal",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Total number of enrolled students at the college.",
          "semantic_type": "quantity",
          "business_concept": "Student Enrollment",
          "aliases": [
            "enrollment",
            "student_count",
            "total_enrolled",
            "headcount"
          ]
        }
      }
    }
  }
}