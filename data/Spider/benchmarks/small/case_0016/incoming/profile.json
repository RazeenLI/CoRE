{
  "database": "incoming",
  "tables": {
    "lessons": {
      "table": {
        "name": "lessons",
        "column_count": 6,
        "summary": "Records individual driving lessons including customer, staff, vehicle, timing, and pricing details.",
        "entity": "Driving Lesson",
        "role": "transaction_table",
        "aliases": [
          "lesson_records",
          "driving_lessons",
          "training_sessions"
        ]
      },
      "columns": {
        "lesson_id": {
          "name": "lesson_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific driving lesson record.",
          "semantic_type": "identifier",
          "business_concept": "Lesson ID",
          "aliases": [
            "id",
            "lesson_number",
            "unique_id"
          ]
        },
        "customer_id": {
          "name": "customer_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier linking the lesson to a specific customer.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Customer ID",
          "aliases": [
            "cust_id",
            "client_id",
            "user_id"
          ]
        },
        "lesson_status_code": {
          "name": "lesson_status_code",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Current status of the lesson (e.g., Completed, Cancelled).",
          "semantic_type": "status",
          "business_concept": "Lesson Status",
          "aliases": [
            "status",
            "state",
            "outcome"
          ]
        },
        "staff_id": {
          "name": "staff_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier of the instructor or staff member assigned to the lesson.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Instructor ID",
          "aliases": [
            "instructor_id",
            "staff_number",
            "driver_id"
          ]
        },
        "lesson_date": {
          "name": "lesson_date",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The date and time when the lesson took place.",
          "semantic_type": "timestamp",
          "business_concept": "Lesson Date",
          "aliases": [
            "date",
            "start_time",
            "event_date"
          ]
        },
        "lesson_time": {
          "name": "lesson_time",
          "dtype": "string",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Duration of the lesson in hours.",
          "semantic_type": "quantity",
          "business_concept": "Lesson Duration",
          "aliases": [
            "duration",
            "hours",
            "length"
          ]
        }
      }
    }
  }
}