{
  "database": "phone_market",
  "tables": {
    "market": {
      "table": {
        "name": "market",
        "column_count": 5,
        "summary": "A dataset containing statistical profiles of various markets, including their geographic location, size metrics, and relative ranking.",
        "entity": "Market",
        "role": "entity_table",
        "aliases": [
          "markets",
          "market_data",
          "market_stats"
        ]
      },
      "columns": {
        "market_id": {
          "name": "market_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A unique identifier for each market record.",
          "semantic_type": "identifier",
          "business_concept": "Market ID",
          "aliases": [
            "id",
            "market_code",
            "market_key"
          ]
        },
        "district": {
          "name": "district",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The geographic region or administrative area where the market is located.",
          "semantic_type": "organization_name",
          "business_concept": "Geographic District",
          "aliases": [
            "region",
            "province",
            "area",
            "location"
          ]
        },
        "num_of_employees": {
          "name": "num_of_employees",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The total count of employees working within the market.",
          "semantic_type": "quantity",
          "business_concept": "Headcount",
          "aliases": [
            "employee_count",
            "staff_size",
            "total_employees"
          ]
        },
        "num_of_shops": {
          "name": "num_of_shops",
          "dtype": "float",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The total number of retail outlets or shops operating within the market.",
          "semantic_type": "quantity",
          "business_concept": "Store Count",
          "aliases": [
            "shop_count",
            "outlet_count",
            "store_size"
          ]
        },
        "ranking": {
          "name": "ranking",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The ordinal position of the market based on a specific metric (e.g., size, revenue).",
          "semantic_type": "code",
          "business_concept": "Market Rank",
          "aliases": [
            "rank",
            "position",
            "order"
          ]
        }
      }
    },
    "phone": {
      "table": {
        "name": "phone",
        "column_count": 5,
