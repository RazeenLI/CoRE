          "semantic_type": "category",
          "business_concept": "product_model_name",
          "aliases": [
            "model",
            "device_name",
            "product_name"
          ]
        },
        "phone_id": {
          "name": "phone_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A unique integer identifier for each phone record.",
