{
  "database": "incoming",
  "tables": {
    "match_season": {
      "table": {
        "name": "match_season",
        "column_count": 3,
        "summary": "A dataset recording player selections in Major League Soccer (MLS) drafts across various seasons, including player details, positions, nationalities, teams, and draft specifics.",
        "entity": "MLS Draft Entry",
        "role": "entity_table",
        "aliases": [
          "mls_draft_records",
          "player_draft_history",
          "season_draft_log"
        ]
      },
      "columns": {
        "season": {
          "name": "season",
          "dtype": "float",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The calendar year in which the draft took place.",
          "semantic_type": "date",
          "business_concept": "Draft Year",
          "aliases": [
            "year",
            "season_year",
            "draft_year"
          ]
        },
        "country": {
          "name": "country",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A numeric code representing the nation of origin for the player.",
          "semantic_type": "code",
          "business_concept": "Nationality Code",
          "aliases": [
            "nation_code",
            "country_code",
            "fifa_code"
          ]
        },
        "draft_pick_number": {
          "name": "draft_pick_number",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The sequential order in which the player was selected within the specific draft class.",
          "semantic_type": "quantity",
          "business_concept": "Draft Pick Order",
          "aliases": [
            "pick",
            "selection_order",
            "round_pick"
          ]
        }
      }
    }
  }
}