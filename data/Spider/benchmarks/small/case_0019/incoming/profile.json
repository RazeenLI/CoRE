{
  "database": "incoming",
  "tables": {
    "bookings": {
      "table": {
        "name": "bookings",
        "column_count": 4,
        "summary": "A transactional table recording customer bookings, including status, dates, financial details (payable, discounts, refunds), and item counts.",
        "entity": "Booking",
        "role": "transaction_table",
        "aliases": [
          "bookings",
          "booking_records",
          "rental_bookings"
        ]
      },
      "columns": {
        "booking_id": {
          "name": "booking_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific booking record.",
          "semantic_type": "identifier",
          "business_concept": "Booking ID",
          "aliases": [
            "id",
            "booking_number",
            "ref_id"
          ]
        },
        "booking_start_date": {
          "name": "booking_start_date",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The timestamp when the booking period begins.",
          "semantic_type": "timestamp",
          "business_concept": "Start Date",
          "aliases": [
            "start_time",
            "pickup_date",
            "from_date"
          ]
        },
        "amount_outstanding": {
          "name": "amount_outstanding",
          "dtype": "decimal",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The remaining balance to be paid after discounts and payments.",
          "semantic_type": "money",
          "business_concept": "Outstanding Balance",
          "aliases": [
            "balance",
            "remaining",
            "due"
          ]
        },
        "amount_of_refund": {
          "name": "amount_of_refund",
          "dtype": "decimal",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The monetary value refunded to the customer.",
          "semantic_type": "money",
          "business_concept": "Refund Amount",
          "aliases": [
            "refund",
            "returned_amount",
            "credit"
          ]
        }
      }
    }
  }
