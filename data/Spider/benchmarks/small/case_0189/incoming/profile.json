            "check_in_date"
          ]
        },
        "date_moved_out": {
          "name": "date_moved_out",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The timestamp when the resident stopped living at the property.",
          "semantic_type": "timestamp",
          "business_concept": "Move-out Date",
          "aliases": [
            "end_date",
            "occupancy_end",
            "check_out_date"
          ]
        },
        "other_details": {
          "name": "other_details",
