          "dtype": "float",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The height of the vehicle above sea level during the flight.",
          "semantic_type": "quantity",
          "business_concept": "Flight Altitude",
          "aliases": [
            "height",
            "elevation",
            "ft"
          ]
        }
      }
    },
