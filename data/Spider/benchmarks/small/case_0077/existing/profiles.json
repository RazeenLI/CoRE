            "number_like"
          ],
          "meaning": "A numeric identifier representing the index or ID of the specific graphics mode.",
          "semantic_type": "code",
          "business_concept": "Mode Index",
          "aliases": [
            "mode_id",
            "mode_index",
            "graphics_id"
          ]
        },
        "char_cells": {
          "name": "char_cells",
          "dtype": "text",
