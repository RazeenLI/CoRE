          "business_concept": "Character Resolution",
          "aliases": [
            "char_res",
            "text_cells",
            "cell_size"
          ]
        },
        "pixels": {
          "name": "pixels",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The physical resolution of the display in pixels (width x height).",
          "semantic_type": "unknown",
          "business_concept": "Pixel Resolution",
          "aliases": [
            "pixel_res",
            "screen_res",
            "resolution"
          ]
        },
        "hardware_colours": {
          "name": "hardware_colours",
          "dtype": "float",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The number of distinct colors supported by the hardware in this mode.",
          "semantic_type": "quantity",
          "business_concept": "Color Depth",
          "aliases": [
            "colors",
            "color_count",
            "palette_size"
          ]
        },
        "used_kb": {
          "name": "used_kb",
          "dtype": "float",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The amount of memory (in kilobytes) consumed by this graphics mode.",
          "semantic_type": "quantity",
          "business_concept": "Memory Usage",
          "aliases": [
            "memory_kb",
            "ram_usage",
            "size_kb"
          ]
        },
        "map": {
          "name": "map",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The hexadecimal memory address range allocated for this graphics mode.",
          "semantic_type": "unknown",
          "business_concept": "Memory Map",
          "aliases": [
            "mem_range",
            "address_range",
            "video_mem"
          ]
        },
        "type": {
          "name": "type",
          "dtype": "text",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "A categorical label describing the nature of the mode (e.g., Graphics vs Text).",
          "semantic_type": "category",
          "business_concept": "Mode Category",
          "aliases": [
            "mode_type",
            "category",
            "kind"
          ]
        }
      }
    },
