        "role": "lookup_table",
        "aliases": [
          "screen_modes",
          "display_modes",
          "video_modes",
          "graphics_modes"
        ]
      },
      "columns": {
        "graphics_mode": {
          "name": "graphics_mode",
          "dtype": "float",
