            "short_code_like"
          ],
          "meaning": "Unique identifier for each institution record.",
          "semantic_type": "identifier",
          "business_concept": "Primary Key",
          "aliases": [
            "id",
            "inst_id",
            "school_id"
          ]
        },
        "institution": {
          "name": "institution",
          "dtype": "text",
          "value_patterns": [],
