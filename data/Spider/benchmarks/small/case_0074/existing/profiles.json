{
  "database": "browser_web",
  "tables": {
    "accelerator_compatible_browser": {
      "table": {
        "name": "accelerator_compatible_browser",
        "column_count": 3,
        "summary": "A lookup table defining the compatibility relationship between hardware accelerators and web browsers, including the year compatibility was established.",
        "entity": "accelerator_browser_compatibility",
        "role": "lookup_table",
        "aliases": [
          "accelerator_browser_compat",
          "browser_accelerator_support",
          "gpu_browser_compat"
        ]
      },
      "columns": {
        "accelerator_id": {
          "name": "accelerator_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific hardware accelerator or GPU model.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Hardware Accelerator ID",
          "aliases": [
            "accelerator_key",
            "gpu_id",
            "device_id"
          ]
        },
        "browser_id": {
          "name": "browser_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific web browser or browser engine.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Browser ID",
          "aliases": [
            "browser_key",
            "engine_id",
            "client_id"
          ]
        },
        "compatible_since_year": {
          "name": "compatible_since_year",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The calendar year in which the accelerator became compatible with the specified browser.",
          "semantic_type": "date",
          "business_concept": "Compatibility Start Year",
          "aliases": [
            "compat_year",
            "supported_since",
            "first_supported_year"
          ]
        }
      }
    },
    "web_client_accelerator": {
      "table": {
        "name": "web_client_accelerator",
        "column_count": 5,
        "summary": "A catalog of web client acceleration software products detailing their names, supported operating systems, target users, and network connection types.",
        "entity": "Web Client Accelerator Product",
        "role": "lookup_table",
        "aliases": [
          "accelerator_products",
          "client_accelerators",
          "web_accelerators",
          "acceleration_software"
        ]
      },
      "columns": {
        "id": {
          "name": "id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for each accelerator product entry.",
          "semantic_type": "identifier",
          "business_concept": "Product ID",
          "aliases": [
            "product_id",
            "accelerator_id",
            "pk"
          ]
        },
        "name": {
          "name": "name",
          "dtype": "text",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "The commercial or common name of the web client accelerator software.",
          "semantic_type": "code",
          "business_concept": "Product Name",
          "aliases": [
            "product_name",
            "title",
            "software_name",
            "brand"
          ]
        },
        "operating_system": {
          "name": "operating_system",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The operating systems or platforms supported by the accelerator software.",
          "semantic_type": "category",
          "business_concept": "Supported Platform",
          "aliases": [
            "os",
            "platform",
            "supported_os",
            "compatibility"
          ]
        },
        "client": {
          "name": "client",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The intended target audience or user type for the accelerator (e.g., end users, ISPs).",
          "semantic_type": "category",
          "business_concept": "Target Audience",
          "aliases": [
            "target_user",
            "user_type",
            "audience",
            "customer_segment"
          ]
        },
        "connection": {
          "name": "connection",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The types of network connections or bandwidth scenarios the accelerator is designed to optimize.",
          "semantic_type": "category",
          "business_concept": "Network Connection Type",
          "aliases": [
            "network_type",
            "connection_type",
            "supported_connections",
            "bandwidth_scenario"
          ]
        }
      }
    }
  }
}