        "role": "transaction_table",
        "aliases": [
          "storm_region_impact",
          "affected_areas",
          "storm_city_count"
        ]
      },
      "columns": {
        "region_id": {
          "name": "region_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a geographic region impacted by the storm.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Geographic Region ID",
          "aliases": [
            "region_code",
            "area_id",
            "geo_id"
          ]
        },
        "storm_id": {
          "name": "storm_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the storm event causing the impact.",
