    "office_locations": {
      "table": {
        "name": "office_locations",
        "column_count": 3,
        "summary": "Stores information about office locations, linking specific buildings to companies and recording the year they moved in.",
        "entity": "Office Location",
        "role": "entity_table",
        "aliases": [
          "office_locations",
          "building_locations",
          "office_sites"
        ]
      },
      "columns": {
        "building_id": {
          "name": "building_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
