{
  "database": "incoming",
  "tables": {
    "order_items": {
      "table": {
        "name": "order_items",
        "column_count": 5,
        "summary": "Stores detailed line items for orders, linking specific products to orders and tracking their fulfillment status.",
        "entity": "Order Item",
        "role": "transaction_table",
        "aliases": [
          "order_lines",
          "order_details",
          "line_items",
          "oi"
        ]
      },
      "columns": {
        "order_item_id": {
          "name": "order_item_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific line item within an order.",
          "semantic_type": "identifier",
          "business_concept": "Order Item ID",
          "aliases": [
            "id",
            "item_id",
            "line_id"
          ]
        },
        "product_id": {
          "name": "product_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference to the specific product included in this order line item.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Product ID",
          "aliases": [
            "prod_id",
            "sku",
            "item_code"
          ]
        },
        "order_id": {
          "name": "order_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference to the parent order containing this line item.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Order ID",
          "aliases": [
            "ord_id",
            "order_number",
            "parent_order"
          ]
        },
        "order_item_status": {
          "name": "order_item_status",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Current state of the order line item (e.g., paid, finished).",
          "semantic_type": "status",
          "business_concept": "Item Status",
          "aliases": [
            "status",
            "state",
            "item_status"
          ]
        },
        "order_item_details": {
          "name": "order_item_details",
          "dtype": "string",
          "value_patterns": [],
          "meaning": "Optional additional text information or notes regarding the specific line item.",
          "semantic_type": "description",
          "business_concept": "Item Notes",
          "aliases": [
            "notes",
            "remarks",
            "description",
            "info"
          ]
        }
      }
    }
  }
}