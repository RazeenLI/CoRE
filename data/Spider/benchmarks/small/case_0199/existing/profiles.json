{
  "database": "insurance_and_eClaims",
  "tables": {
    "claims_processing": {
      "table": {
        "name": "claims_processing",
        "column_count": 4,
        "summary": "Stores the current processing status, stage, and assigned staff for individual insurance claims.",
        "entity": "Claim Processing Record",
        "role": "transaction_table",
        "aliases": [
          "claims_status",
          "claim_worklist",
          "claim_assignment"
        ]
      },
      "columns": {
        "claim_processing_id": {
          "name": "claim_processing_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific record in the claims processing log.",
          "semantic_type": "identifier",
          "business_concept": "Processing Record ID",
          "aliases": [
            "proc_id",
            "claim_proc_key",
            "log_id"
          ]
        },
        "claim_id": {
          "name": "claim_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference to the specific insurance claim being processed.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Claim Reference",
          "aliases": [
            "claim_ref",
            "claim_number",
            "parent_claim_id"
          ]
        },
        "claim_outcome_code": {
          "name": "claim_outcome_code",
          "dtype": "string",
          "value_patterns": [],
          "meaning": "Textual description of the current resolution status of the claim.",
          "semantic_type": "status",
          "business_concept": "Claim Outcome",
          "aliases": [
            "claim_status",
            "resolution_code",
            "outcome_desc"
          ]
        },
        "claim_stage_id": {
          "name": "claim_stage_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Numeric identifier representing the current step in the claims workflow.",
          "semantic_type": "code",
          "business_concept": "Workflow Stage",
          "aliases": [
            "stage_num",
            "process_step",
            "workflow_id"
          ]
        }
      }
    },
    "staff": {
      "table": {
        "name": "staff",
        "column_count": 2,
        "summary": "A table containing core identification and name information for staff members.",
        "entity": "staff",
        "role": "entity_table",
        "aliases": [
          "employees",
          "personnel",
          "staff_list",
          "user_directory"
        ]
      },
      "columns": {
        "staff_id": {
          "name": "staff_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A unique numeric identifier assigned to each staff member.",
          "semantic_type": "identifier",
          "business_concept": "Primary Key",
          "aliases": [
            "id",
            "staff_number",
            "emp_id",
            "employee_id"
          ]
        },
        "staff_details": {
          "name": "staff_details",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "The first name of the staff member.",
          "semantic_type": "person_name",
          "business_concept": "First Name",
          "aliases": [
            "first_name",
            "fname",
            "given_name",
            "staff_name"
          ]
        }
      }
    },
    "claims_documents": {
      "table": {
        "name": "claims_documents",
        "column_count": 4,
        "summary": "Stores metadata and creation details for various documents associated with insurance claims.",
        "entity": "claim_document",
        "role": "entity_table",
        "aliases": [
          "claims_docs",
          "claim_documents",
          "doc_metadata"
        ]
      },
      "columns": {
        "claim_id": {
          "name": "claim_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier linking the document to a specific insurance claim.",
          "semantic_type": "identifier",
          "business_concept": "claim_reference",
          "aliases": [
            "claim_ref",
            "claim_no",
            "claim_number"
          ]
        },
        "document_type_code": {
          "name": "document_type_code",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Categorical code indicating the type of document (e.g., Medical, Document).",
          "semantic_type": "code",
          "business_concept": "document_category",
          "aliases": [
            "doc_type",
            "document_category",
            "type_code"
          ]
        },
        "created_by_staff_id": {
          "name": "created_by_staff_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier of the staff member who created or uploaded the document.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "staff_identifier",
          "aliases": [
            "creator_id",
            "staff_id",
            "uploader_id"
          ]
        },
        "created_date": {
          "name": "created_date",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Timestamp representing when the document was created or uploaded, stored as an integer (likely Unix epoch or similar).",
          "semantic_type": "timestamp",
          "business_concept": "creation_time",
          "aliases": [
            "create_time",
            "upload_date",
            "recorded_at"
          ]
        }
      }
    }
  }
}