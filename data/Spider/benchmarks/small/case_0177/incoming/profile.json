{
  "database": "incoming",
  "tables": {
    "driverstandings": {
      "table": {
        "name": "driverstandings",
        "column_count": 7,
        "summary": "Records the current championship standings for drivers within a specific race, including their points, position, and number of wins.",
        "entity": "Driver Standings",
        "role": "transaction_table",
        "aliases": [
          "driver_standings",
          "championship_standings",
          "race_standings",
          "driver_rankings"
        ]
      },
      "columns": {
        "driverstandingsid": {
          "name": "driverstandingsid",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific driver's standing record in a race.",
          "semantic_type": "identifier",
          "business_concept": "Primary Key",
          "aliases": [
            "ds_id",
            "standings_id",
            "id"
          ]
        },
        "raceid": {
          "name": "raceid",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier linking the standing record to a specific race event.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Race Reference",
          "aliases": [
            "race_id",
            "r_id",
            "event_id"
          ]
        },
        "driverid": {
          "name": "driverid",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier linking the standing record to a specific driver.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Driver Reference",
          "aliases": [
            "driver_id",
            "d_id",
            "pid"
          ]
        },
        "points": {
          "name": "points",
          "dtype": "float",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "Total championship points accumulated by the driver in the current race context.",
          "semantic_type": "quantity",
          "business_concept": "Championship Points",
          "aliases": [
            "pts",
            "score",
            "total_points"
          ]
        },
        "position": {
          "name": "position",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Numerical rank of the driver among all participants in the standings.",
          "semantic_type": "code",
          "business_concept": "Ranking Position",
          "aliases": [
            "pos",
            "rank",
            "place"
          ]
        },
        "positiontext": {
          "name": "positiontext",
          "dtype": "text",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Textual representation of the driver's rank (e.g., '1st', '2nd').",
          "semantic_type": "code",
          "business_concept": "Ranking Label",
          "aliases": [
            "pos_text",
            "rank_text",
            "place_text"
          ]
        },
        "wins": {
          "name": "wins",
          "dtype": "integer",
          "value_patterns": [
            "boolean_like",
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Count of race victories achieved by the driver in the current context.",
          "semantic_type": "quantity",
          "business_concept": "Race Wins",
          "aliases": [
            "win_count",
            "victories",
            "wins_total"
          ]
        }
      }
    }
  }
}