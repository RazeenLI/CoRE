{
  "database": "twitter_1",
  "tables": {
    "tweets": {
      "table": {
        "name": "tweets",
        "column_count": 4,
        "summary": "A collection of short text messages (tweets) containing user content, author identifiers, and creation timestamps.",
        "entity": "Tweet",
        "role": "entity_table",
        "aliases": [
          "twitter_posts",
          "microblog_posts",
          "social_media_posts",
          "user_updates"
        ]
      },
      "columns": {
        "id": {
          "name": "id",
          "dtype": "bigint(20)",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for each tweet record.",
          "semantic_type": "identifier",
          "business_concept": "Tweet ID",
          "aliases": [
            "tweet_id",
            "post_id",
            "message_id"
          ]
        },
        "uid": {
          "name": "uid",
          "dtype": "int(11)",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the user who authored the tweet.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "User ID",
          "aliases": [
            "user_id",
            "author_id",
            "account_id"
          ]
        },
        "text": {
          "name": "text",
          "dtype": "string",
          "value_patterns": [],
          "meaning": "The main content or body of the tweet message.",
          "semantic_type": "description",
          "business_concept": "Tweet Content",
          "aliases": [
            "message",
            "body",
            "content",
            "status_text"
          ]
        },
        "createdate": {
          "name": "createdate",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The timestamp indicating when the tweet was created.",
          "semantic_type": "timestamp",
          "business_concept": "Creation Time",
          "aliases": [
            "created_at",
            "post_date",
            "timestamp",
            "datetime"
          ]
        }
      }
    },
    "follows": {
      "table": {
        "name": "follows",
        "column_count": 2,
        "summary": "A table representing social graph connections or follower relationships between users.",
        "entity": "follow",
        "role": "relationship_table",
        "aliases": [
          "followers",
          "following",
          "user_connections",
          "social_links"
        ]
      },
      "columns": {
        "f1": {
          "name": "f1",
          "dtype": "int(11)",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the user who is following (the follower).",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "follower_id",
          "aliases": [
            "follower_id",
            "user_id",
            "source_id",
            "from_user"
          ]
        },
        "f2": {
          "name": "f2",
          "dtype": "int(11)",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the user being followed (the followee).",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "followee_id",
          "aliases": [
            "followee_id",
            "user_id",
            "target_id",
            "to_user"
          ]
        }
      }
    }
  }
}