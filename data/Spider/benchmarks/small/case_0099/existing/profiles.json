{
  "database": "station_weather",
  "tables": {
    "station": {
      "table": {
        "name": "station",
        "column_count": 4,
        "summary": "A reference table containing details about railway stations, including their unique identifiers, associated local authorities, and the train services operating there.",
        "entity": "Railway Station",
        "role": "lookup_table",
        "aliases": [
          "stations",
          "railway_stations",
          "train_stations",
          "station_info"
        ]
      },
      "columns": {
        "id": {
          "name": "id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for each railway station record.",
          "semantic_type": "identifier",
          "business_concept": "Station ID",
          "aliases": [
            "station_id",
            "station_code",
            "station_key"
          ]
        },
        "network_name": {
          "name": "network_name",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The name of the local authority or network area associated with the station.",
          "semantic_type": "organization_name",
          "business_concept": "Local Authority / Network Name",
          "aliases": [
            "authority_name",
            "network",
            "area_name",
            "local_authority_name"
          ]
        },
        "services": {
          "name": "services",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "List of train operating companies or lines that serve this station.",
          "semantic_type": "category",
          "business_concept": "Operating Services",
          "aliases": [
            "train_services",
            "operators",
            "lines",
            "service_providers"
          ]
        },
        "local_authority": {
          "name": "local_authority",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The specific local government authority responsible for the station's area.",
          "semantic_type": "organization_name",
          "business_concept": "Local Authority",
          "aliases": [
            "authority",
            "local_gov",
            "district",
            "council"
          ]
        }
      }
    },
    "route": {
      "table": {
        "name": "route",
        "column_count": 2,
        "summary": "Defines the connectivity or adjacency between train stations, likely representing a segment of a rail network.",
        "entity": "Route Segment",
        "role": "relationship_table",
        "aliases": [
          "route",
          "train_route",
          "station_connection",
          "rail_link"
        ]
      },
      "columns": {
        "train_id": {
          "name": "train_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific train line or service.",
          "semantic_type": "code",
          "business_concept": "Train Line Identifier",
          "aliases": [
            "train_code",
            "line_id",
            "service_id"
          ]
        },
        "station_id": {
          "name": "station_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific station involved in the route segment.",
          "semantic_type": "code",
          "business_concept": "Station Identifier",
          "aliases": [
            "station_code",
            "stop_id",
            "node_id"
          ]
        }
      }
    }
  }
}