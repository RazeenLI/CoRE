{
  "database": "mountain_photos",
  "tables": {
    "photos": {
      "table": {
        "name": "photos",
        "column_count": 5,
        "summary": "A table storing metadata and attributes for a collection of photos, including their subject matter, color format, and associated equipment or location identifiers.",
        "entity": "photo",
        "role": "entity_table",
        "aliases": [
          "image_metadata",
          "photo_catalog",
          "picture_records"
        ]
      },
      "columns": {
        "id": {
          "name": "id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for each photo record in the table.",
          "semantic_type": "identifier",
          "business_concept": "Photo ID",
          "aliases": [
            "photo_id",
            "image_id",
            "record_id"
          ]
        },
        "camera_lens_id": {
          "name": "camera_lens_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Foreign key referencing the specific camera lens used to take the photo.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Lens Reference",
          "aliases": [
            "lens_id",
            "camera_lens_ref",
            "optics_id"
          ]
        },
        "mountain_id": {
          "name": "mountain_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Foreign key referencing the mountain location where the photo was taken.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Location Reference",
          "aliases": [
            "location_id",
            "mountain_ref",
            "site_id"
          ]
        },
        "color": {
          "name": "color",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The color format or mode of the photo (e.g., RGB, Black/White).",
          "semantic_type": "category",
          "business_concept": "Image Color Mode",
          "aliases": [
            "color_mode",
            "format",
            "color_profile"
          ]
        },
        "name": {
          "name": "name",
          "dtype": "text",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "A descriptive label or subject tag for the photo.",
          "semantic_type": "description",
          "business_concept": "Photo Subject/Tag",
          "aliases": [
            "subject",
            "topic",
            "label",
            "caption"
          ]
        }
      }
    },
    "camera_lens": {
