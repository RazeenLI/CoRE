          "semantic_type": "date",
          "business_concept": "Air Date",
          "aliases": [
            "broadcast_date",
            "original_air_date",
            "date"
          ]
        },
        "rating": {
          "name": "rating",
          "dtype": "text",
          "value_patterns": [
            "number_like"
