          "semantic_type": "quantity",
          "business_concept": "Nielsen Share",
          "aliases": [
            "share_pct",
            "tv_share",
            "audience_share"
          ]
        },
        "18_49_rating_share": {
          "name": "18_49_rating_share",
          "dtype": "text",
          "value_patterns": [],
          "meaning": "The rating and share specifically for the 18-49 demographic, formatted as 'rating/share'.",
          "semantic_type": "quantity",
          "business_concept": "Demographic Rating Share (18-49)",
          "aliases": [
            "18_49_data",
            "demo_rating_share",
            "target_audience_share"
          ]
        },
        "viewers_m": {
          "name": "viewers_m",
          "dtype": "text",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The estimated number of viewers in millions.",
          "semantic_type": "quantity",
