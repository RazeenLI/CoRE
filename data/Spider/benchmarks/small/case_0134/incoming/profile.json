        "role": "entity_table",
        "aliases": [
          "tv_episodes",
          "series_episodes",
          "episode_metrics",
          "broadcast_data"
        ]
      },
      "columns": {
        "id": {
          "name": "id",
          "dtype": "float",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "Unique identifier for each episode record.",
          "semantic_type": "identifier",
          "business_concept": "Episode ID",
          "aliases": [
            "episode_id",
            "ep_id",
            "series_id"
          ]
        },
        "episode": {
          "name": "episode",
          "dtype": "text",
          "value_patterns": [],
