          "medication_enzyme_interaction"
        ]
      },
      "columns": {
        "enzyme_id": {
          "name": "enzyme_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for an enzyme involved in the interaction.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Enzyme Identifier",
          "aliases": [
            "enzyme_code",
            "enzyme_ref",
            "enzyme_key"
          ]
        },
        "medicine_id": {
