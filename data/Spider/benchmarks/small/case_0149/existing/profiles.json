          "business_concept": "regulatory_status",
          "aliases": [
            "approved",
            "fda_status",
            "status"
          ]
        }
      }
    },
    "medicine_enzyme_interaction": {
      "table": {
        "name": "medicine_enzyme_interaction",
        "column_count": 3,
