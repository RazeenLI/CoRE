{
  "database": "incoming",
  "tables": {
    "match_result": {
      "table": {
        "name": "match_result",
        "column_count": 4,
        "summary": "Records the performance metrics and rankings of clubs in a competition, including points, medals, and specific tier counts.",
        "entity": "club",
        "role": "transaction_table",
        "aliases": [
          "match_results",
          "competition_standings",
          "club_performance",
          "tournament_results"
        ]
      },
      "columns": {
        "rank": {
          "name": "rank",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The ordinal position of the club in the competition standings.",
          "semantic_type": "code",
          "business_concept": "ranking_position",
          "aliases": [
            "position",
            "order",
            "place",
            "sort_order"
          ]
        },
        "club_id": {
          "name": "club_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "A unique identifier for the club participating in the competition.",
          "semantic_type": "identifier",
          "business_concept": "club_identifier",
          "aliases": [
            "club_code",
            "team_id",
            "organization_id",
            "entity_id"
          ]
        },
        "big_silver": {
          "name": "big_silver",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The count of large silver medals or second-tier awards won by the club.",
          "semantic_type": "quantity",
          "business_concept": "big_silver_medal_count",
          "aliases": [
            "big_silver_medals",
            "bs",
            "second_place_large",
            "silver_large"
          ]
        },
        "bronze": {
          "name": "bronze",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The count of bronze medals or fourth-tier awards won by the club.",
          "semantic_type": "quantity",
          "business_concept": "bronze_medal_count",
          "aliases": [
            "bronze_medals",
            "b",
            "third_place",
            "bronze_count"
          ]
        }
      }
    }
  }
}