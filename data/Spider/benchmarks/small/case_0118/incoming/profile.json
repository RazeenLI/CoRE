{
  "database": "incoming",
  "tables": {
    "votes": {
      "table": {
        "name": "votes",
        "column_count": 5,
        "summary": "Records of votes cast by phone numbers for specific contestants in different US states.",
        "entity": "Vote",
        "role": "transaction_table",
        "aliases": [
          "voting_records",
          "phone_votes",
          "contestant_votes"
        ]
      },
      "columns": {
        "timestamp": {
          "name": "timestamp",
          "dtype": "timestamp",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The timestamp when the vote was recorded in the system.",
          "semantic_type": "timestamp",
          "business_concept": "Vote Creation Time",
          "aliases": [
            "vote_time",
            "created_at",
            "timestamp"
          ]
        },
        "us_state": {
          "name": "us_state",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "The US state associated with the vote or the voter's location.",
          "semantic_type": "code",
          "business_concept": "State Code",
          "aliases": [
            "state_abbr",
            "location_code",
            "us_state"
          ]
        },
        "voter_phone": {
          "name": "voter_phone",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The telephone number of the voter who cast the vote.",
          "semantic_type": "phone",
          "business_concept": "Voter Phone Number",
          "aliases": [
            "caller_id",
            "voter_phone",
            "subscriber_number"
          ]
        },
        "candidate_number": {
          "name": "candidate_number",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The unique identifier for the contestant receiving the vote.",
          "semantic_type": "identifier",
          "business_concept": "Contestant ID",
          "aliases": [
            "contestant_id",
            "candidate_number",
            "player_id"
          ]
        },
        "primary_key": {
          "name": "primary_key",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for each vote record.",
          "semantic_type": "identifier",
          "business_concept": "Vote ID",
          "aliases": [
            "id",
            "vote_key",
            "primary_key"
          ]
        }
      }
    }
  }
}