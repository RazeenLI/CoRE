{
  "database": "incoming",
  "tables": {
    "visit": {
      "table": {
        "name": "visit",
        "column_count": 4,
        "summary": "Records of museum visits including visitor identification, ticket counts, and total spending.",
        "entity": "visit",
        "role": "transaction_table",
        "aliases": [
          "visits",
          "museum_visits",
          "visit_records"
        ]
      },
      "columns": {
        "museum_id": {
          "name": "museum_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the museum where the visit occurred.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "museum",
          "aliases": [
            "museum_code",
            "museum_identifier",
            "site_id"
          ]
        },
        "visitor_id": {
          "name": "visitor_id",
          "dtype": "text",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the visitor making the purchase or visit.",
          "semantic_type": "identifier",
          "business_concept": "visitor",
          "aliases": [
            "visitor_code",
            "user_id",
            "guest_id"
          ]
        },
        "num_of_ticket": {
          "name": "num_of_ticket",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The quantity of tickets purchased or used during the visit.",
          "semantic_type": "quantity",
          "business_concept": "ticket_quantity",
          "aliases": [
            "ticket_count",
            "tickets_purchased",
            "num_tickets"
          ]
        },
        "total_spent": {
          "name": "total_spent",
          "dtype": "float",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The total monetary amount spent by the visitor for this visit.",
          "semantic_type": "money",
          "business_concept": "revenue",
          "aliases": [
            "amount",
            "cost",
            "payment_total",
            "spending"
          ]
        }
      }
    }
  }
}