{
  "database": "incoming",
  "tables": {
    "order_items": {
      "table": {
        "name": "order_items",
        "column_count": 3,
        "summary": "Stores the line-level details of orders, linking specific products to orders with their respective quantities.",
        "entity": "Order Item",
        "role": "transaction_table",
        "aliases": [
          "order_lines",
          "order_details",
          "items"
        ]
      },
      "columns": {
        "order_item_id": {
          "name": "order_item_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific line item within an order.",
          "semantic_type": "identifier",
          "business_concept": "Line Item ID",
          "aliases": [
            "item_id",
            "order_line_id",
            "id"
          ]
        },
        "order_id": {
          "name": "order_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference to the parent order containing this item.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Order Reference",
          "aliases": [
            "parent_order_id",
            "order_ref",
            "order_no"
          ]
        },
        "order_quantity": {
          "name": "order_quantity",
          "dtype": "string",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The number of units of the product ordered in this specific line item.",
          "semantic_type": "quantity",
          "business_concept": "Ordered Quantity",
          "aliases": [
            "qty",
            "quantity",
            "amount",
            "count"
          ]
        }
      }
    }
  }
}