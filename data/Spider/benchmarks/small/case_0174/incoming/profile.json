{
  "database": "incoming",
  "tables": {
    "bug_reports": {
      "table": {
        "name": "bug_reports",
        "column_count": 8,
        "summary": "A log table recording individual problem entries, including assignment details, categorization, status, and timestamps.",
        "entity": "Problem Log Entry",
        "role": "transaction_table",
        "aliases": [
          "problem_logs",
          "issue_logs",
          "support_tickets",
          "bug_reports"
        ]
      },
      "columns": {
        "log_id": {
          "name": "log_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for each log entry record.",
          "semantic_type": "identifier",
          "business_concept": "Primary Key",
          "aliases": [
            "id",
            "log_id",
            "entry_id"
          ]
        },
        "assigned_by": {
          "name": "assigned_by",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier linking the log entry to the staff member assigned to handle it.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Assigned Staff Reference",
          "aliases": [
            "staff_id",
            "assigned_by",
            "user_id",
            "agent_id"
          ]
        },
        "problem_ref": {
          "name": "problem_ref",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier linking the log entry to the specific problem or issue it belongs to.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Problem Reference",
          "aliases": [
            "issue_id",
            "ticket_id",
            "bug_id",
            "problem_ref"
          ]
        },
        "issue_type": {
          "name": "issue_type",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Categorical code or label defining the type of the problem (e.g., Middleware, GUI).",
          "semantic_type": "category",
          "business_concept": "Problem Category",
          "aliases": [
            "category",
            "type",
            "issue_type",
            "problem_type"
          ]
        },
        "issue_status": {
          "name": "issue_status",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Current state or status of the problem (e.g., Solved, Reported).",
          "semantic_type": "status",
          "business_concept": "Problem Status",
          "aliases": [
            "status",
            "state",
            "issue_status",
            "resolution_status"
          ]
        },
        "timestamp": {
          "name": "timestamp",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "Timestamp indicating when the log entry was created or updated.",
          "semantic_type": "timestamp",
          "business_concept": "Log Timestamp",
          "aliases": [
            "created_at",
            "updated_at",
            "date",
            "timestamp",
            "entry_time"
          ]
        },
        "comment": {
          "name": "comment",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Brief textual description or note associated with the log entry.",
          "semantic_type": "description",
          "business_concept": "Entry Description",
          "aliases": [
            "notes",
            "comment",
            "details",
            "message",
            "summary"
          ]
        },
        "resolution": {
          "name": "resolution",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "Description of the fix or action taken to resolve the issue.",
          "semantic_type": "description",
          "business_concept": "Fix Description",
          "aliases": [
            "resolution",
            "fix_notes",
            "action_taken",
            "solution"
          ]
        }
      }
    }
  }
}