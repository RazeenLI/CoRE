{
  "database": "incoming",
  "tables": {
    "lessons": {
      "table": {
        "name": "lessons",
        "column_count": 5,
        "summary": "Records individual driving lessons including customer, staff, vehicle, timing, and pricing details.",
        "entity": "Driving Lesson",
        "role": "transaction_table",
        "aliases": [
          "lesson_records",
          "driving_lessons",
          "training_sessions"
        ]
      },
      "columns": {
        "lesson_id": {
          "name": "lesson_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for a specific driving lesson record.",
          "semantic_type": "identifier",
          "business_concept": "Lesson ID",
          "aliases": [
            "id",
            "lesson_number",
            "unique_id"
          ]
        },
        "staff_id": {
          "name": "staff_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier of the instructor or staff member assigned to the lesson.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Instructor ID",
          "aliases": [
            "instructor_id",
            "staff_number",
            "driver_id"
          ]
        },
        "vehicle_id": {
          "name": "vehicle_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier of the vehicle used for the lesson.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Vehicle ID",
          "aliases": [
            "car_id",
            "vehicle_number",
            "unit_id"
          ]
        },
        "lesson_date": {
          "name": "lesson_date",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The date and time when the lesson took place.",
          "semantic_type": "timestamp",
          "business_concept": "Lesson Date",
          "aliases": [
            "date",
            "start_time",
            "event_date"
          ]
        },
        "price": {
          "name": "price",
          "dtype": "double",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The monetary cost charged for the lesson.",
          "semantic_type": "money",
          "business_concept": "Lesson Price",
          "aliases": [
            "cost",
            "amount",
            "fee",
            "rate"
          ]
        }
      }
    }
  }
}