{
  "database": "incoming",
  "tables": {
    "purchase": {
      "table": {
        "name": "purchase",
        "column_count": 4,
        "summary": "A transactional table recording purchase amounts aggregated by member, branch, and year.",
        "entity": "purchase",
        "role": "transaction_table",
        "aliases": [
          "purchases",
          "buy_records",
          "sales_log"
        ]
      },
      "columns": {
        "member_id": {
          "name": "member_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the customer or member making the purchase.",
          "semantic_type": "identifier",
          "business_concept": "customer_id",
          "aliases": [
            "cust_id",
            "user_id",
            "member_no"
          ]
        },
        "branch_id": {
          "name": "branch_id",
          "dtype": "text",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Identifier for the specific branch or location where the purchase occurred.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "store_id",
          "aliases": [
            "branch_code",
            "location_id",
            "shop_id"
          ]
        },
        "year": {
          "name": "year",
          "dtype": "text",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "The calendar year in which the purchase transaction took place.",
          "semantic_type": "date",
          "business_concept": "transaction_year",
          "aliases": [
            "yr",
            "fiscal_year",
            "year_code"
          ]
        },
        "total_pounds": {
          "name": "total_pounds",
          "dtype": "float",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "The total monetary value of the purchase in pounds currency.",
          "semantic_type": "money",
          "business_concept": "purchase_amount",
          "aliases": [
            "amount",
            "total",
            "price",
            "sum"
          ]
        }
      }
    }
  }
}