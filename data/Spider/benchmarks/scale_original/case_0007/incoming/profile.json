{
  "database": "incoming",
  "tables": {
    "party_addresses": {
      "table": {
        "name": "party_addresses",
        "column_count": 5,
        "summary": "Stores historical address records linked to specific parties, tracking the validity period and type of each address.",
        "entity": "Address",
        "role": "relationship_table",
        "aliases": [
          "party_addresses",
          "addresses",
          "address_history",
          "party_address_log"
        ]
      },
      "columns": {
        "party_id": {
          "name": "party_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the party (customer, client, or entity) associated with the address.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Party Identifier",
          "aliases": [
            "party",
            "customer_id",
            "client_id",
            "account_id",
            "id"
          ]
        },
        "address_id": {
          "name": "address_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for the specific address record within the system.",
          "semantic_type": "identifier",
          "business_concept": "Address Record ID",
          "aliases": [
            "addr_id",
            "address_key",
            "id"
          ]
        },
        "date_address_from": {
          "name": "date_address_from",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The start date and time when this address became valid for the party.",
