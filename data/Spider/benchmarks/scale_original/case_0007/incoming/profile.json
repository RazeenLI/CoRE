            "effective_date"
          ]
        },
        "address_type_code": {
          "name": "address_type_code",
          "dtype": "string",
          "value_patterns": [
            "short_code_like"
          ],
          "meaning": "A categorical code indicating the purpose of the address (e.g., residence, billing, delivery).",
          "semantic_type": "code",
          "business_concept": "Address Type",
          "aliases": [
            "addr_type",
            "type_code",
            "address_category",
            "purpose"
          ]
        },
        "date_address_to": {
          "name": "date_address_to",
          "dtype": "datetime",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "The end date and time when this address ceased to be valid for the party (nullable if currently active).",
          "semantic_type": "timestamp",
          "business_concept": "Address Validity End Date",
          "aliases": [
            "to_date",
            "end_date",
            "valid_to",
            "expiry_date"
          ]
        }
