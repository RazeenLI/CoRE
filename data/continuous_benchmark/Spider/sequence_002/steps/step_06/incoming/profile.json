          "film_actor_link",
          "movie_actor"
        ]
      },
      "columns": {
        "actor_id": {
          "name": "actor_id",
          "dtype": "smallint unsigned",
          "value_patterns": [
            "boolean_like",
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for an actor referenced in this relationship.",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Actor ID",
          "aliases": [
            "actor_id",
            "id_actor",
            "fk_actor"
          ]
        },
        "film_id": {
          "name": "film_id",
