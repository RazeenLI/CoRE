          "business_concept": "Film ID",
          "aliases": [
            "film_id",
            "id_film",
            "fk_film",
            "movie_id"
          ]
        },
        "last_update": {
          "name": "last_update",
          "dtype": "timestamp",
          "value_patterns": [
            "timestamp_like"
          ],
          "meaning": "Timestamp indicating when the record of this actor-film association was last modified.",
          "semantic_type": "timestamp",
