{
  "database": "chinook",
  "dialect": "postgresql",
  "tables": [
    {
      "table": "customer",
      "rows": 10,
      "columns": [
        "customer_id",
        "first_name",
        "last_name",
        "company",
        "address",
        "city",
        "state",
        "country",
        "postal_code",
        "phone",
        "fax",
        "email",
        "support_rep_id"
      ],
      "primary_key": [
        "customer_id"
      ]
    },
    {
      "table": "invoice",
      "rows": 10,
      "columns": [
        "invoice_id",
        "customer_id",
        "invoice_date",
        "billing_address",
        "billing_city",
        "billing_state",
        "billing_country",
        "billing_postal_code",
        "total"
      ],
      "primary_key": [
        "invoice_id"
      ]
    },
    {
      "table": "artist",
      "rows": 10,
      "columns": [
        "artist_id",
        "name"
      ],
      "primary_key": [
        "artist_id"
      ]
    },
    {
      "table": "album",
      "rows": 10,
      "columns": [
        "album_id",
        "title",
        "artist_id"
      ],
      "primary_key": [
        "album_id"
      ]
    },
    {
      "table": "track",
      "rows": 10,
      "columns": [
        "track_id",
        "name",
        "album_id",
        "media_type_id",
        "genre_id",
        "composer",
        "milliseconds",
        "bytes",
        "unit_price"
      ],
      "primary_key": [
        "track_id"
      ]
    },
    {
      "table": "invoice_line",
      "rows": 10,
      "columns": [
        "invoice_line_id",
        "invoice_id",
        "track_id",
        "unit_price",
        "quantity"
      ],
      "primary_key": [
        "invoice_line_id"
      ]
    }
  ],
  "referential_dependencies": [
    {
      "from_table": "album",
      "from_columns": [
        "artist_id"
      ],
      "to_table": "artist",
      "to_columns": [
        "artist_id"
      ],
      "name": "album_artist_id_fkey",
      "on_delete": "no_action",
      "on_update": "no_action"
    },
    {
      "from_table": "invoice",
      "from_columns": [
        "customer_id"
      ],
      "to_table": "customer",
      "to_columns": [
        "customer_id"
      ],
      "name": "invoice_customer_id_fkey",
      "on_delete": "no_action",
      "on_update": "no_action"
    },
    {
      "from_table": "invoice_line",
      "from_columns": [
        "invoice_id"
      ],
      "to_table": "invoice",
      "to_columns": [
        "invoice_id"
      ],
      "name": "invoice_line_invoice_id_fkey",
      "on_delete": "no_action",
      "on_update": "no_action"
    },
    {
      "from_table": "invoice_line",
      "from_columns": [
        "track_id"
      ],
      "to_table": "track",
      "to_columns": [
        "track_id"
      ],
      "name": "invoice_line_track_id_fkey",
      "on_delete": "no_action",
      "on_update": "no_action"
    },
    {
      "from_table": "track",
      "from_columns": [
        "album_id"
      ],
      "to_table": "album",
      "to_columns": [
        "album_id"
      ],
      "name": "track_album_id_fkey",
      "on_delete": "no_action",
      "on_update": "no_action"
    }
  ]
}