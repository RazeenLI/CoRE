{
  "database": "incoming",
  "dialect": "postgresql",
  "version": "v1",
  "tables": {
    "invoice": {
      "columns": {
        "invoice_id": {
          "type_raw": "INT",
          "type": "integer",
          "nullable": false
        },
        "customer_id": {
          "type_raw": "INT",
          "type": "integer",
          "nullable": false
        },
        "invoice_date": {
          "type_raw": "TIMESTAMP",
          "type": "timestamp",
          "nullable": false
        },
        "billing_address": {
          "type_raw": "VARCHAR(70)",
          "type": "string",
          "max_length": 70,
          "nullable": true
        },
        "billing_city": {
          "type_raw": "VARCHAR(40)",
          "type": "string",
          "max_length": 40,
          "nullable": true
        },
        "billing_state": {
          "type_raw": "VARCHAR(40)",
          "type": "string",
          "max_length": 40,
          "nullable": true
        },
        "billing_country": {
          "type_raw": "VARCHAR(40)",
          "type": "string",
          "max_length": 40,
          "nullable": true
        },
        "billing_postal_code": {
          "type_raw": "VARCHAR(10)",
          "type": "string",
          "max_length": 10,
          "nullable": true
        },
        "total": {
          "type_raw": "NUMERIC(10,2)",
          "type": "decimal",
          "precision": 10,
          "scale": 2,
          "nullable": false
        }
      },
      "column_order": [
        "invoice_id",
        "customer_id",
        "invoice_date",
        "billing_address",
        "billing_city",
        "billing_state",
        "billing_country",
        "billing_postal_code",
        "total"
      ]
    }
  }
}