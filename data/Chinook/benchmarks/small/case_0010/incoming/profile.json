          "business_concept": "Track Identifier",
          "aliases": [
            "track_ref",
            "track_id"
          ]
        },
        "unit_price": {
          "name": "unit_price",
          "dtype": "decimal",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "Price per unit for the invoice line item",
          "semantic_type": "money",
