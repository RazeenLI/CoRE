          "invoice_details"
        ]
      },
      "columns": {
        "invoice_line_id": {
          "name": "invoice_line_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for each invoice line item",
          "semantic_type": "identifier",
          "business_concept": "Invoice Line Identifier",
          "aliases": [
            "line_id",
            "invoice_line_key"
          ]
        },
        "track_id": {
          "name": "track_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference to the tracked item (e.g., product, track)",
