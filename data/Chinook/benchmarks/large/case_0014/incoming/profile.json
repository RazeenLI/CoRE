        "role": "transaction_table",
        "aliases": [
          "invoice_line_items",
          "invoice_details"
        ]
      },
      "columns": {
        "invoice_line_id": {
          "name": "invoice_line_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for each invoice line item",
          "semantic_type": "identifier",
          "business_concept": "Invoice Line Identifier",
          "aliases": [
            "line_id",
            "invoice_line_key"
          ]
        },
        "invoice_id": {
          "name": "invoice_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference to the parent invoice",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Invoice Reference",
          "aliases": [
            "invoice_ref",
            "invoice_key"
          ]
        },
        "track_id": {
          "name": "track_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference to the tracked item (e.g., product, track)",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Track Identifier",
          "aliases": [
            "track_ref",
            "track_id"
          ]
        },
        "quantity": {
          "name": "quantity",
          "dtype": "integer",
          "value_patterns": [
            "boolean_like",
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Number of units for the invoice line item",
          "semantic_type": "quantity",
          "business_concept": "Quantity Sold",
          "aliases": [
