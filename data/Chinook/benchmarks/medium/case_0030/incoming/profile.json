{
  "database": "incoming",
  "tables": {
    "invoice_line": {
      "table": {
        "name": "invoice_line",
        "column_count": 5,
        "summary": "A table representing line items on invoices, tracking individual items with their pricing and quantities.",
        "entity": "Invoice Line",
        "role": "transaction_table",
        "aliases": [
          "invoice_line_items",
          "invoice_details"
        ]
      },
      "columns": {
        "line_id": {
          "name": "line_id",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Unique identifier for each invoice line item",
          "semantic_type": "identifier",
          "business_concept": "Invoice Line Identifier",
          "aliases": [
            "line_id",
            "invoice_line_key"
          ]
        },
        "invoice_ref": {
          "name": "invoice_ref",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference to the parent invoice",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Invoice Reference",
          "aliases": [
            "invoice_ref",
            "invoice_key"
          ]
        },
        "track_ref": {
          "name": "track_ref",
          "dtype": "integer",
          "value_patterns": [
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Reference to the tracked item (e.g., product, track)",
          "semantic_type": "foreign_key_candidate",
          "business_concept": "Track Identifier",
          "aliases": [
            "track_ref",
            "track_id"
          ]
        },
        "price_per_unit": {
          "name": "price_per_unit",
          "dtype": "decimal",
          "value_patterns": [
            "number_like"
          ],
          "meaning": "Price per unit for the invoice line item",
          "semantic_type": "money",
          "business_concept": "Unit Price",
          "aliases": [
            "price_per_unit",
            "unit_cost"
          ]
        },
        "item_count": {
          "name": "item_count",
          "dtype": "integer",
          "value_patterns": [
            "boolean_like",
            "integer_like",
            "short_code_like"
          ],
          "meaning": "Number of units for the invoice line item",
          "semantic_type": "quantity",
          "business_concept": "Quantity Sold",
          "aliases": [
            "item_count",
            "units_sold"
          ]
        }
      }
    }
  }
}